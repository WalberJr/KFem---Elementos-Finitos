mpi4py    | mpi4py-${MPI4PY_VERSION}.tar.gz    | https://files.pythonhosted.org/packages/source/m/mpi4py/mpi4py-${MPI4PY_VERSION}.tar.gz
h5py      | h5py-${H5PY_VERSION}.tar.gz        | https://files.pythonhosted.org/packages/source/h/h5py/h5py-${H5PY_VERSION}.tar.gz
basix     | basix-${BASIX_VERSION}.tar.gz      | https://github.com/FEniCS/basix/archive/refs/tags/v${BASIX_VERSION}.tar.gz
ufl       | ufl-${UFL_VERSION}.tar.gz          | https://github.com/FEniCS/ufl/archive/refs/tags/${UFL_VERSION}.tar.gz
