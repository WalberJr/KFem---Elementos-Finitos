# KFem — versões fixadas da pilha (Etapa 0, pesquisado em 2026-11-17)
#
# Regras:
# - Nunca usar "latest". Toda versão aqui foi conferida nas fontes oficiais
#   (GitHub releases/tags, PyPI, python.org, download.qt.io, vtk.org, gmsh.info,
#   developer.download.nvidia.com) na data acima.
# - Preferência por versões estáveis com pelo menos ~2 semanas de lançamento.
# - Os SHA256_* são preenchidos na Etapa 1, ao baixar cada fonte, conferindo com o
#   checksum publicado pelo projeto (quando houver). Build falha se o SHA não bater.
# - Dependências de PETSc baixadas via --download-* (MUMPS, hypre, ScaLAPACK, METIS,
#   ParMETIS, PT-Scotch) usam as versões e checksums que o próprio PETSc fixa.

# ---------- Toolchain / base ----------
PYTHON_VERSION=3.14.10          # 3.15 saiu em out/2026; 3.14 tem ecossistema mais maduro
CMAKE_VERSION=4.4.5             # 4.5.0 lançado há 5 dias; usar a 4.4 corrente
NINJA_VERSION=1.13.2
CCACHE_VERSION=4.14.3

# ---------- Numérico (CPU) ----------
BISON_VERSION=3.8.2             # ferramenta de build (Scotch); não vai no AppImage
FLEX_VERSION=2.6.4              # idem
SCOTCH_VERSION=7.0.18           # PT-Scotch (CeCILL-C) compilado à parte p/ ter SCOTCHConfig.cmake (DOLFINx)
OPENBLAS_VERSION=0.3.34
MPICH_VERSION=5.0.2             # MPI escolhido: MPICH (ver ADR 0004)
HDF5_VERSION=2.2.0
ADIOS2_VERSION=2.12.1
BOOST_VERSION=1.92.0
SPDLOG_VERSION=1.17.0
PUGIXML_VERSION=1.16
PYBIND11_VERSION=3.1.0
NANOBIND_VERSION=2.15.0          # DOLFINx 0.11 usa inteiros do cffi; o nanobind 3.x exige __index__ (incompatível)
PETSC_VERSION=3.26.1
PETSC4PY_VERSION=3.26.1
MPI4PY_VERSION=4.1.2
NUMPY_VERSION=2.5.5
SCIPY_VERSION=1.18.1
CFFI_VERSION=2.1.1
H5PY_VERSION=3.16.0

# ---------- FEniCSx (conjunto compatível) ----------
DOLFINX_VERSION=0.11.0          # tag v0.11.0 (release v0.11.0.post0 só corrige empacotamento)
BASIX_VERSION=0.11.0
FFCX_VERSION=0.11.0
UFL_VERSION=2026.1.0            # DOLFINx/FFCx 0.11 exigem UFL >=2026.1.0,<2026.2.0

# ---------- Geometria / malha / utilitários ----------
OCCT_VERSION=7.9.3               # kernel OCC do Gmsh; 8.0 é recente e muda API (incluído 2026-11-18)
OCCT_TAG=V7_9_3
GMSH_VERSION=4.15.2
MESHIO_VERSION=5.3.5
PINT_VERSION=0.26.2

# ---------- Interface / visualização ----------
QT_VERSION=6.12.0               # LTS
PYSIDE6_VERSION=6.12.0          # mesma série do Qt
SHIBOKEN6_VERSION=6.12.0
VTK_VERSION=9.7.2
PYVISTA_VERSION=0.49.1          # 0.49.2 no PyPI é muito recente; reavaliar na Etapa 2
PYVISTAQT_VERSION=0.13.2
MATPLOTLIB_VERSION=3.11.2

# ---------- Backends de GPU (Etapa 11; candidatos, confirmar antes de compilar) ----------
CUDA_VERSION=13.4.3             # redistribuíveis NVIDIA; 13.5.0 de 2026-11-04 é recente demais
ROCM_VERSION=7.2.4              # existe tag rocm-7.14.0; verificar na Etapa 11 qual é a estável
OPENCL_ICD_LOADER_VERSION=2026.05.29
VIENNACL_VERSION=1.7.1          # última versão publicada (antiga); PETSc 3.26.1 ainda tem seqviennacl
KOKKOS_VERSION=5.3.0            # só se a Etapa 11 optar por Kokkos

# ---------- Empacotamento ----------
APPIMAGETOOL_VERSION=continuous-2026-11-06   # projeto só publica "continuous"; fixar pelo hash do binário
LINUXDEPLOY_VERSION=1-alpha-20251107-1

# ---------- Fontes (URLs base) ----------
URL_PYTHON=https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz
URL_PETSC=https://web.cels.anl.gov/projects/petsc/download/release-snapshots/petsc-${PETSC_VERSION}.tar.gz
URL_DOLFINX=https://github.com/FEniCS/dolfinx/archive/refs/tags/v${DOLFINX_VERSION}.tar.gz
URL_BASIX=https://github.com/FEniCS/basix/archive/refs/tags/v${BASIX_VERSION}.tar.gz
URL_FFCX=https://github.com/FEniCS/ffcx/archive/refs/tags/v${FFCX_VERSION}.tar.gz
URL_UFL=https://github.com/FEniCS/ufl/archive/refs/tags/${UFL_VERSION}.tar.gz
URL_GMSH=https://gmsh.info/src/gmsh-${GMSH_VERSION}-source.tgz
URL_QT=https://download.qt.io/official_releases/qt/6.12/${QT_VERSION}/submodules/
URL_PYSIDE6=https://download.qt.io/official_releases/QtForPython/pyside6/
URL_VTK=https://www.vtk.org/files/release/9.7/VTK-${VTK_VERSION}.tar.gz
URL_MPICH=https://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz
URL_HDF5=https://github.com/HDFGroup/hdf5/releases/tag/${HDF5_VERSION}
URL_OPENBLAS=https://github.com/OpenMathLib/OpenBLAS/releases/download/v${OPENBLAS_VERSION}/OpenBLAS-${OPENBLAS_VERSION}.tar.gz
# Demais: tarball da tag no GitHub ou sdist no PyPI da versão acima.
