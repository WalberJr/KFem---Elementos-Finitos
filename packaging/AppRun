#!/bin/bash
# KFem AppRun: ambiente relocável + detecção de GPU antes de iniciar (ADR 0005/0011/0013).
# Não empacota drivers: libGL/libvulkan/libdrm/libcuda/ICDs OpenCL/ROCm vêm do sistema.
HERE="$(dirname "$(readlink -f "$0")")"
export KFEM_SDK="$HERE/usr"
export KFEM_APPDIR="$HERE"
export PATH="$HERE/usr/bin:$PATH"
export PYTHONHOME="$HERE/usr"
export PYTHONNOUSERSITE=1
export QT_PLUGIN_PATH="$HERE/usr/qt6/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/qt6/plugins/platforms"
export HYDRA_BOOTSTRAP=fork
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
SRC="$HERE/usr/share/kfem/src"
BASE_LD="$HERE/usr/lib:$HERE/usr/lib64:$HERE/usr/qt6/lib"
# 1) detecção do backend (com teste de sanidade, guardado em ~/.cache/kfem) com a variante CPU
eval "$(PYTHONPATH="$HERE/usr/petsc-cpu/lib:$SRC" LD_LIBRARY_PATH="$HERE/usr/petsc-cpu/lib:$BASE_LD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
  "$HERE/usr/bin/python3" -m kfem.hw.env_shell 2>/dev/null)"
export PETSC_DIR="${PETSC_DIR:-$HERE/usr/petsc-cpu}"
# 2) ambiente final com a variante escolhida
export PYTHONPATH="$PETSC_DIR/lib:$SRC${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$PETSC_DIR/lib:$BASE_LD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# a DOLFINx compila os núcleos de cada modelo em tempo de execução: precisa de um compilador C
if ! command -v gcc >/dev/null 2>&1 && ! command -v cc >/dev/null 2>&1; then
  echo "KFem: aviso — nenhum compilador C (gcc) encontrado; instale-o para resolver modelos (ex.: sudo apt install gcc)." >&2
fi
# KFem-x86_64.AppImage --python SCRIPT.py [args]: roda um script com o Python e o KFem do pacote
# (gerar projetos por script, pós-processar resultados)
if [[ "${1:-}" == "--python" ]]; then
  shift
  exec "$HERE/usr/bin/python3" "$@"
fi
exec "$HERE/usr/bin/python3" -m kfem.app.cli "$@"
