# nome | arquivo local | URL   (variáveis de versions.env são expandidas)
cmake     | cmake-${CMAKE_VERSION}.tar.gz      | https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}.tar.gz
ninja     | ninja-${NINJA_VERSION}.tar.gz      | https://github.com/ninja-build/ninja/archive/refs/tags/v${NINJA_VERSION}.tar.gz
ccache    | ccache-${CCACHE_VERSION}.tar.xz    | https://github.com/ccache/ccache/releases/download/v${CCACHE_VERSION}/ccache-${CCACHE_VERSION}.tar.xz
python    | Python-${PYTHON_VERSION}.tar.xz    | https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz
openblas  | OpenBLAS-${OPENBLAS_VERSION}.tar.gz | https://github.com/OpenMathLib/OpenBLAS/releases/download/v${OPENBLAS_VERSION}/OpenBLAS-${OPENBLAS_VERSION}.tar.gz
mpich     | mpich-${MPICH_VERSION}.tar.gz      | https://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz
hdf5      | hdf5-${HDF5_VERSION}.tar.gz        | https://github.com/HDFGroup/hdf5/archive/refs/tags/${HDF5_VERSION}.tar.gz
petsc     | petsc-${PETSC_VERSION}.tar.gz      | https://web.cels.anl.gov/projects/petsc/download/release-snapshots/petsc-${PETSC_VERSION}.tar.gz
spdlog    | spdlog-${SPDLOG_VERSION}.tar.gz    | https://github.com/gabime/spdlog/archive/refs/tags/v${SPDLOG_VERSION}.tar.gz
pugixml   | pugixml-${PUGIXML_VERSION}.tar.gz  | https://github.com/zeux/pugixml/releases/download/v${PUGIXML_VERSION}/pugixml-${PUGIXML_VERSION}.tar.gz
boost     | boost-${BOOST_VERSION}.tar.gz      | https://github.com/boostorg/boost/releases/download/boost-${BOOST_VERSION}/boost-${BOOST_VERSION}-cmake.tar.gz
pybind11  | pybind11-${PYBIND11_VERSION}.tar.gz | https://files.pythonhosted.org/packages/source/p/pybind11/pybind11-${PYBIND11_VERSION}.tar.gz
nanobind  | nanobind-${NANOBIND_VERSION}.tar.gz | https://files.pythonhosted.org/packages/source/n/nanobind/nanobind-${NANOBIND_VERSION}.tar.gz
numpy     | numpy-${NUMPY_VERSION}.tar.gz      | https://files.pythonhosted.org/packages/source/n/numpy/numpy-${NUMPY_VERSION}.tar.gz
